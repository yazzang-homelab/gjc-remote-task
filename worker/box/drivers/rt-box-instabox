#!/usr/bin/python3
"""gjc-rt 박스 드라이버: instabox.sh microVM. instabox CLI와 instabox-q(박스 위 FIFO 대기줄 도구)를 감싼다.

계약은 worker/box/drivers/README.md. 대상 설정은 RT_BOX_TARGET(JSON): alias(instabox-q 별칭), machine(instabox 머신 이름).
instabox-q는 이 저장소에 없다. 다른 대기줄을 쓰려면 이 파일을 본떠 드라이버를 새로 만든다.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime

ENV = {**os.environ, "INSTABOX_NO_TELEMETRY": "1", "INSTABOX_NO_UPDATE_CHECK": "1"}
NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")


def die(code: str, detail: str = "", rc: int = 2) -> None:
    sys.stderr.write(f"{code}{': ' + detail if detail else ''}\n")
    sys.exit(rc)


def target() -> dict:
    try:
        t = json.loads(os.environ.get("RT_BOX_TARGET") or "{}")
    except ValueError:
        die("bad_target", "RT_BOX_TARGET")
    for k in ("alias", "machine"):
        if not isinstance(t, dict) or not isinstance(t.get(k), str) or not NAME_RE.fullmatch(t[k]):
            die("bad_target", k)
    return t


def q_argv(*args: str) -> list[str]:
    return ["instabox-q", "-b", target()["alias"], *args]


def run(*args: str, timeout: float = 600) -> subprocess.CompletedProcess:
    return subprocess.run(q_argv(*args), stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=ENV, timeout=timeout)


def passthrough(*args: str) -> int:
    os.execvpe("instabox-q", q_argv(*args), ENV)
    return 127


def box_times(m: dict, now: float) -> dict:
    """instabox get 결과 → 상태·쿨다운 남은 초·실행 한도까지 남은 분(한도 없음은 None; 잠든 박스는 깨우면 새 실행이라 한도 전체)."""
    def ts(v):
        try:
            return datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp() if v else None
        except (AttributeError, ValueError):
            return None
    cool = ts(m.get("cooldownUntil"))
    cooldown_s = max(0, int((cool - now) // 1)) if cool is not None else 0
    cap = m.get("maxRunMinutes") or 0
    run_at = ts(m.get("runStartedAt"))
    if cap <= 0:
        left = None
    elif m.get("state") == "running" and run_at is not None:
        left = max(0, int((cap - (now - run_at) / 60) // 1))
    else:
        left = cap
    return {"state": m.get("state"), "cooldown_s": cooldown_s, "run_left_min": left}


def op_info(_args):
    # instabox-q boxes는 모든 박스를 읽어 CPU가 10배쯤 든다. 이 머신만 instabox get으로 읽는다(박스를 깨우지 않는다).
    try:
        r = run("cli", "get", target()["machine"], "--json", timeout=60)
    except subprocess.TimeoutExpired:
        return 2
    if r.returncode != 0:
        return 2
    try:
        m = json.loads(r.stdout)  # 여러 줄로 들여 쓴 객체 하나
    except ValueError:
        return 2
    if not isinstance(m, dict) or not isinstance(m.get("state"), str):
        return 2
    print(json.dumps(box_times(m, time.time())))
    return 0


def op_put(args):
    return passthrough("cli", "cp", "-r", "-p", f"{args[0]}/.", f"{target()['machine']}:{args[1]}")


def op_exec(args):
    if args[:1] == ["--"]:
        args = args[1:]
    return passthrough("cli", "exec", target()["machine"], "--", *args)


def op_submit(args):
    # 마지막 줄이 대기줄 작업 id. 종료코드 3은 투입 검사 거절이다.
    return passthrough("submit", "--name", args[0], "--timeout", args[1], "-f", args[2])


def op_status(args):
    try:
        txt = run("status", args[0], timeout=120).stdout.decode("utf-8", "replace")
    except subprocess.TimeoutExpired:
        txt = ""
    m = re.search(r"^state=(\w+)", txt, re.M)
    ec = re.search(r"^exit_code=(\S*)", txt, re.M)
    print(json.dumps({"state": m.group(1) if m else "unknown", "exit": (ec.group(1) or None) if ec else None}))
    return 0


def op_wait(args):
    # instabox-q wait은 기다리는 동안 activity lease를 잡아 박스가 잠들지 않게 한다.
    return passthrough("wait", args[0])


def op_cancel(args):
    r = run("cancel", args[0], timeout=120)
    out = r.stdout.decode("utf-8", "replace")
    # 대기줄의 cancel은 pending 파일 삭제와 워커의 pending→running 이동 중 하나만 성공한다.
    # "cancelled pending"이면 job.sh가 한 번도 실행되지 않았다(미시작 증명).
    print(json.dumps({"pending_cancelled": bool(re.search(r"cancelled pending", out)), "detail": out.strip()[-200:]}))
    return 0


def op_fetch(args):
    return passthrough("fetch", args[0], args[1], "--max-bytes", args[2])


def op_forward(args):
    return passthrough("cli", "port-forward", target()["machine"], f"{int(args[0])}:{int(args[1])}")


def op_pump_rw(_args):
    # instabox port-forward는 ~/.config/instabox/ssh에 연결 설정을 쓴다.
    print(os.path.join(os.path.expanduser("~"), ".config", "instabox"))
    return 0


OPS = {"info": (op_info, 0), "put": (op_put, 2), "exec": (op_exec, 1), "submit": (op_submit, 3), "status": (op_status, 1),
       "wait": (op_wait, 1), "cancel": (op_cancel, 1), "fetch": (op_fetch, 3), "forward": (op_forward, 2), "pump-rw": (op_pump_rw, 0)}


def main(argv):
    if not argv or argv[0] not in OPS or len(argv) - 1 < OPS[argv[0]][1]:
        die("usage", "rt-box-instabox " + "|".join(OPS))
    return OPS[argv[0]][0](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
