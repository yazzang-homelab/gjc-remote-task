def v_cancel(origin: str, args: list[str]) -> None:
    if len(args) != 2:
        raise HelperError("bad_argument", "cancel", 64)
    job, gen = need("job", args[0]), int(need("gen", args[1]))
    meta = check_cap(origin, job)
    if meta["gen"] != gen:
        raise HelperError("gen_mismatch", status=3)
    unit = unit_name(job, gen)
    with Flock(os.path.join(job_state_dir(job), "lock")):
        seal(job, gen, "cancel")
        info = unit_show(unit)
        if info.get("LoadState") == "loaded" and info.get("ActiveState") in ("active", "activating", "deactivating"):
            subprocess.run(["systemctl", "stop", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=300)
        else:
            # 시작 전 취소: 슬롯을 바로 반납한다.
            with Flock(SLOTS_LOCK):
                slots = [s for s in slots_load() if not (s["job"] == job and s["gen"] == gen and s["state"] in ("reserved", "staged"))]
                slots_save(slots)
            if meta.get("state") in ("reserved", "staged"):
                meta_update(job, state="failed", failure="cancelled_before_launch")
    emit({"ok": True, "sealed": True, "unit": unit_show(unit).get("ActiveState"),
          "ended": read_root_json(ended_marker(job, gen))})


def do_cleanup(job: str, meta: dict) -> dict:
    unit = unit_show(unit_name(job, meta["gen"]))
    if unit.get("ActiveState") in ("active", "activating", "deactivating"):
        raise HelperError("job_running", status=3)
    sdir = job_state_dir(job)
    if os.path.exists(os.path.join(sdir, "cleaned")):
        return {"ok": True, "already": True}
    w = os.path.join(WORK, job)
    if os.path.lexists(w):
        if os.path.islink(w) or not os.path.isdir(w):
            raise HelperError("state_untrusted", "work", 3)
        worktool_json(["cleanup", job], job, timeout=1800, bundle_version=meta["bundle_version"])
        os.rmdir(w)
    with Flock(SLOTS_LOCK):
        slots = [s for s in slots_load() if s["job"] != job]
        slots_save(slots)
    write_root_json(os.path.join(sdir, "cleaned"), {"at": iso()})
    meta_update(job, cleaned=iso())
    return {"ok": True, "already": False}


def v_cleanup(origin: str, args: list[str]) -> None:
    job = need("job", args[0]) if len(args) == 1 else None
    if not job:
        raise HelperError("bad_argument", "cleanup", 64)
    meta = check_cap(origin, job)
    emit(do_cleanup(job, meta))


