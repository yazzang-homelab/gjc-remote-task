#!/usr/bin/python3
"""gjc-rt root helper. 진입 계정 gjcrt-ctl이 sudo로만 부른다(계획 §16.1).

원칙
- 호출자를 믿지 않는다. 모든 인자는 정규식으로 검사하고, 경로는 job_id에서만 만든다.
- root가 직접 여닫는 것은 root 소유 경로뿐이다. 잡 작업 디렉터리는 setpriv로 권한을 내린
  rt-worktool이 다룬다(§17.1, §18.1).
- 인증: reserve·install-gjc는 호스트 등록 토큰, 나머지는 잡 cap 토큰(HMAC). 토큰은 stdin 첫 줄로만 받는다.
"""
from __future__ import annotations

import fcntl
import hashlib
import hmac
import json
import os
import pwd
import re
import secrets
import shutil
import subprocess
import sys
import time
import urllib.request

LIB = "/usr/local/lib/gjc-rt"
ETC = "/etc/gjc-rt"
PRIV = "/etc/gjc-rt/private"
STATE = "/var/lib/gjc-rt"
WORK = "/srv/gjc-rt/work"
REPOS = "/srv/gjc-rt/repos"
SHARED_CACHE = "/srv/gjc-rt/cache"
KEY_FILE = "/var/lib/gjc-rt/keys/gjc-rt.key"
RUN_USER = "gjcrt"
PROTO = 1

RX = {
    "origin": re.compile(r"^[a-z][a-z0-9-]{0,31}$"),
    "job": re.compile(r"^rt-[0-9a-z]{26}$"),
    "gen": re.compile(r"^[0-9]{1,6}$"),
    "seq": re.compile(r"^[0-9]{1,12}$"),
    "num": re.compile(r"^[0-9]{1,6}$"),
    "version": re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+$"),
    "sha256": re.compile(r"^[0-9a-f]{64}$"),
    "model": re.compile(r"^[A-Za-z0-9._:/@+-]{1,120}$"),
    "session": re.compile(r"^[A-Za-z0-9-]{8,64}$"),
    "msgid": re.compile(r"^msg-[0-9a-z]{10,40}$"),
    "replyto": re.compile(r"^(-|q-[0-9a-z-]{3,40})$"),
    "repo": re.compile(r"^[0-9a-f]{16,64}$"),
}


class HelperError(Exception):
    def __init__(self, code: str, detail: str = "", status: int = 2):
        super().__init__(code)
        self.code, self.detail, self.status = code, detail, status


def need(kind: str, value: str) -> str:
    if not isinstance(value, str) or not RX[kind].match(value):
        raise HelperError("bad_argument", kind, 64)
    return value


def emit(obj) -> None:
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def now() -> float:
    return time.time()


def iso(t: float | None = None) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t if t is not None else now()))


# ---------------------------------------------------------------- 설정·파일

def load_config() -> dict:
    with open(os.path.join(ETC, "config.json"), encoding="utf-8") as f:
        cfg = json.load(f)
    cfg.setdefault("max_slots", 2)
    cfg.setdefault("load_max", 0.7)
    cfg.setdefault("disk_min_gb", 5)
    cfg.setdefault("job_memory_max", "8G")
    cfg.setdefault("job_tasks_max", 2048)
    cfg.setdefault("cargo_jobs", 4)
    cfg.setdefault("psi_cpu_max", 20.0)
    cfg.setdefault("psi_mem_max", 10.0)
    cfg.setdefault("contention_slice", None)
    cfg.setdefault("contention_psi_max", 10.0)
    cfg.setdefault("allowed_models", [])
    cfg.setdefault("lease_s", 900)
    return cfg


def read_root_file(path: str) -> str:
    st = os.lstat(path)
    if st.st_uid != 0 or not os.path.isfile(path) or os.path.islink(path):
        raise HelperError("config_untrusted", os.path.basename(path))
    with open(path, encoding="utf-8") as f:
        return f.read()


def job_state_dir(job: str) -> str:
    return os.path.join(STATE, "jobs", need("job", job))


def ensure_root_dir(path: str, mode: int = 0o700) -> None:
    os.makedirs(path, mode=mode, exist_ok=True)
    st = os.lstat(path)
    if st.st_uid != 0 or not os.path.isdir(path) or os.path.islink(path):
        raise HelperError("state_untrusted", path)


def write_root_json(path: str, obj) -> None:
    tmp = f"{path}.tmp{os.getpid()}"
    fd = os.open(tmp, os.O_CREAT | os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False)
    os.replace(tmp, path)


def read_root_json(path: str, default=None):
    try:
        return json.loads(read_root_file(path))
    except FileNotFoundError:
        return default


class Flock:
    def __init__(self, path: str):
        self.path = path

    def __enter__(self):
        self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)


# ---------------------------------------------------------------- 인증

def read_auth_line() -> list[str]:
    # fd에서 한 바이트씩 읽는다. 버퍼 독자를 쓰면 뒤 본문을 미리 삼켜, fd를 넘겨받은 하위 프로세스가 앞부분을 잃는다.
    line = b""
    while not line.endswith(b"\n") and len(line) < 512:
        ch = os.read(0, 1)
        if not ch:
            break
        line += ch
    return line.decode("ascii", "replace").strip().split(" ")


def check_reg(origin: str) -> None:
    parts = read_auth_line()
    path = os.path.join(PRIV, "hosts", f"{origin}.token")
    token = read_root_file(path).strip() if os.path.lexists(path) else ""
    if not token or len(parts) != 2 or parts[0] != "reg" or not hmac.compare_digest(parts[1], token):
        raise HelperError("unauthorized", "reg", 77)


def cap_token(origin: str, session: str, job: str, gen: int) -> str:
    key = read_root_file(os.path.join(PRIV, "cap.key")).strip().encode()
    return hmac.new(key, f"{origin}|{session}|{job}|{gen}".encode(), hashlib.sha256).hexdigest()


def check_cap(origin: str, job: str) -> dict:
    parts = read_auth_line()
    meta = read_root_json(os.path.join(job_state_dir(job), "meta.json"))
    if meta is None:
        raise HelperError("job_unknown", status=3)
    if len(parts) != 3 or parts[0] != "cap" or parts[1] != meta["main_session"] or meta["origin"] != origin:
        raise HelperError("unauthorized", "cap", 77)
    expected = cap_token(origin, meta["main_session"], job, meta["gen"])
    if not hmac.compare_digest(parts[2], expected):
        raise HelperError("unauthorized", "cap", 77)
    return meta


# ---------------------------------------------------------------- 권한을 내린 실행

def run_user():
    return pwd.getpwnam(RUN_USER)


def worktool(args: list[str], job: str | None, stdin=None, stdout=subprocess.PIPE, timeout: float | None = 600,
             bundle_version: str | None = None, input_bytes: bytes | None = None) -> subprocess.CompletedProcess:
    cfg = load_config()
    ver = bundle_version or cfg["bundle_version"]
    home = os.path.join(WORK, job, "home") if job else "/nonexistent"
    cmd = ["/usr/bin/setpriv", f"--reuid={RUN_USER}", f"--regid={RUN_USER}", "--init-groups", "--no-new-privs",
           "--reset-env", "/usr/bin/env", f"HOME={home}", "PATH=/usr/local/bin:/usr/bin:/bin", "LANG=C.UTF-8",
           "/usr/bin/python3", os.path.join(LIB, "bundle", ver, "rt-worktool.py"), *args]
    if input_bytes is not None:
        return subprocess.run(cmd, input=input_bytes, stdout=stdout, stderr=subprocess.PIPE, timeout=timeout, cwd="/")
    return subprocess.run(cmd, stdin=stdin, stdout=stdout, stderr=subprocess.PIPE, timeout=timeout, cwd="/")


def worktool_json(args: list[str], job: str | None, **kw) -> dict:
    proc = worktool(args, job, **kw)
    if proc.returncode != 0:
        try:
            err = json.loads(proc.stderr.decode("utf-8", "replace").strip().splitlines()[-1])
        except (ValueError, IndexError):
            err = {"error": "worktool_failed"}
        raise HelperError(err.get("error", "worktool_failed"), err.get("detail", ""), 3)
    return json.loads(proc.stdout.decode("utf-8").strip().splitlines()[-1])


def worktool_input(args: list[str], job: str, data: bytes, bundle_version: str, timeout: float = 1800) -> dict:
    """stdin으로 자료를 넘기고 JSON 한 줄을 받는다."""
    proc = worktool(args, job, stdin=None, timeout=timeout, bundle_version=bundle_version, input_bytes=data)
    if proc.returncode != 0:
        try:
            err = json.loads(proc.stderr.decode("utf-8", "replace").strip().splitlines()[-1])
        except (ValueError, IndexError):
            err = {"error": "worktool_failed"}
        raise HelperError(err.get("error", "worktool_failed"), err.get("detail", ""), 3)
    return json.loads(proc.stdout.decode("utf-8").strip().splitlines()[-1])


def worktool_stream(args: list[str], job: str, bundle_version: str) -> None:
    """작업 도구의 stdout 바이트를 그대로 중계한다(root는 경로를 열지 않는다)."""
    proc = worktool(args, job, stdout=sys.stdout.buffer, timeout=1800, bundle_version=bundle_version)
    if proc.returncode != 0:
        try:
            err = json.loads(proc.stderr.decode("utf-8", "replace").strip().splitlines()[-1])
        except (ValueError, IndexError):
            err = {"error": "worktool_failed"}
        sys.stderr.write(json.dumps(err) + "\n")
        raise SystemExit(3)


# ---------------------------------------------------------------- 시스템 사실

def load_snapshot() -> dict:
    load1 = float(open("/proc/loadavg").read().split()[0])
    ncpu = os.cpu_count() or 1
    mem = {}
    for line in open("/proc/meminfo"):
        k, v = line.split(":", 1)
        mem[k] = int(v.split()[0])
    disk = shutil.disk_usage("/srv")

    def psi(path: str) -> float | None:
        # some avg60(계획 §15.5 중단 기준). avg10은 순간 변동이 커서 쓰지 않는다.
        try:
            for line in open(path):
                if line.startswith("some"):
                    return float(line.split()[2].split("=")[1])
        except OSError:
            return None
        return None

    cfg = load_config()
    snap = {"load1": load1, "ncpu": ncpu, "load_ratio": round(load1 / ncpu, 3),
            "mem_avail_ratio": round(mem.get("MemAvailable", 0) / max(1, mem.get("MemTotal", 1)), 3),
            "disk_free_gb": round(disk.free / 1e9, 1), "psi_cpu": psi("/proc/pressure/cpu"),
            "psi_mem": psi("/proc/pressure/memory")}
    if cfg.get("contention_slice"):
        snap["contention_psi"] = psi(f"/sys/fs/cgroup/{cfg['contention_slice']}/cpu.pressure")
    return snap


def boot_id() -> str:
    return open("/proc/sys/kernel/random/boot_id").read().strip()


def unit_name(job: str, gen: int) -> str:
    return f"rt-{job[3:]}-g{gen}.service"


def unit_show(unit: str) -> dict:
    proc = subprocess.run(["systemctl", "show", unit, "-p", "LoadState,ActiveState,SubState,InvocationID,Result,ExecMainStatus"],
                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30)
    out = {}
    for line in proc.stdout.decode().splitlines():
        k, _, v = line.partition("=")
        out[k] = v
    return out


def installed_gjc() -> list[str]:
    base = os.path.join(LIB, "gjc")
    try:
        return sorted(v for v in os.listdir(base) if RX["version"].match(v))
    except FileNotFoundError:
        return []


def host_platform() -> str:
    """릴리스 자산 이름의 플랫폼(linux-x64, linux-arm64). 원점이 이 값으로 올릴 gjc를 고른다."""
    m = os.uname().machine.lower()
    return "linux-" + {"x86_64": "x64", "amd64": "x64", "aarch64": "arm64", "arm64": "arm64"}.get(m, m)


def trusted_gjc() -> dict:
    """신뢰표 "<판> <플랫폼> <sha256>" 가운데 이 호스트 플랫폼 줄만 {판: sha}로 읽는다."""
    table = {}
    plat = host_platform()
    for line in read_root_file(os.path.join(ETC, "trusted-gjc.sha256")).splitlines():
        parts = line.split()
        if len(parts) == 3 and RX["version"].match(parts[0]) and parts[1] == plat and RX["sha256"].match(parts[2]):
            table[parts[0]] = parts[2]
    return table


def gjc_binary_ok(version: str) -> bool:
    path = os.path.join(LIB, "gjc", version, "gjc")
    want = trusted_gjc().get(version)
    if not want or not os.path.isfile(path):
        return False
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest() == want


def normalize_model(sel: str) -> str:
    return sel.split(":", 1)[0].lower()


def hub_models(cfg: dict) -> tuple[list[str] | None, str | None]:
    """전용 키로 허브 /v1/models를 본다(10분 캐시). 실패하면 (None, 사유)."""
    cache_path = os.path.join(STATE, "models-cache.json")
    cache = read_root_json(cache_path, {}) or {}
    if cache.get("at", 0) > now() - 600 and isinstance(cache.get("ids"), list):
        return cache["ids"], None
    if not os.path.exists(KEY_FILE):
        return None, "credential_missing"
    key = read_root_file(KEY_FILE).strip()
    req = urllib.request.Request(cfg["hub_models_url"], headers={"Authorization": f"Bearer {key}"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read(4 << 20))
    except Exception as exc:  # noqa: BLE001 - 원인 종류만 보고
        return None, f"probe_failed:{type(exc).__name__}"
    ids = sorted({str(m.get("id", "")).lower() for m in data.get("data", []) if isinstance(m, dict)})
    write_root_json(cache_path, {"at": now(), "ids": ids})
    return ids, None


def model_check(cfg: dict, sel: str) -> str | None:
    norm = normalize_model(sel)
    allowed = [normalize_model(m) for m in cfg["allowed_models"]]
    if norm not in allowed:
        return "model_not_allowed"
    ids, err = hub_models(cfg)
    if err:
        return err
    provider_prefix = cfg["provider"] + "/"
    bare = norm[len(provider_prefix):] if norm.startswith(provider_prefix) else norm
    if bare not in ids and norm not in ids:
        return "model_unavailable"
    return None


# ---------------------------------------------------------------- 슬롯 원장 (§15.2, §16.3)

SLOTS = os.path.join(STATE, "slots.json")
SLOTS_LOCK = os.path.join(STATE, "slots.lock")


def slots_load() -> list[dict]:
    return (read_root_json(SLOTS, {"slots": []}) or {"slots": []})["slots"]


def slots_save(slots: list[dict]) -> None:
    write_root_json(SLOTS, {"slots": slots})


def ended_marker(job: str, gen: int) -> str:
    return os.path.join(job_state_dir(job), f"ended-g{gen}.json")


def seal(job: str, gen: int, reason: str) -> None:
    path = os.path.join(job_state_dir(job), f"sealed-g{gen}")
    if not os.path.exists(path):
        write_root_json(path, {"at": iso(), "reason": reason})


def meta_update(job: str, **fields) -> None:
    path = os.path.join(job_state_dir(job), "meta.json")
    meta = read_root_json(path)
    if meta is None:
        return
    meta.update(fields)
    write_root_json(path, meta)


def reclaim(slots: list[dict]) -> list[dict]:
    """증거가 있을 때만 슬롯을 회수한다. 자동 재시작은 없다(P-5)."""
    keep = []
    t = now()
    bid = boot_id()
    for s in slots:
        job, gen = s["job"], s["gen"]
        if os.path.exists(ended_marker(job, gen)):
            continue  # ending + ended 표식 → 반납
        if s["state"] in ("reserved", "staged"):
            unit = unit_show(unit_name(job, gen))
            if unit.get("LoadState") == "loaded" and unit.get("InvocationID"):
                # 유닛 생성 뒤 기록 전에 끊긴 경우를 먼저 채운다(§16.3).
                s.update(state="launched", invocation=unit["InvocationID"], boot_id=bid)
                keep.append(s)
                continue
            if s["lease_until"] < t:
                seal(job, gen, "lease_expired")
                meta_update(job, state="failed", failure="lease_expired")
                continue
            keep.append(s)
            continue
        if s["state"] == "launched":
            unit = unit_show(unit_name(job, gen))
            gone = unit.get("LoadState") == "not-found" or unit.get("InvocationID") != s.get("invocation") \
                or s.get("boot_id") != bid
            if gone:
                meta_update(job, state="failed", failure="lost")
                continue
        keep.append(s)
    return keep


# ---------------------------------------------------------------- 동사

def v_hello(origin: str, args: list[str]) -> None:
    cfg = load_config()
    emit({"ok": True, "proto": PROTO, "bundle_version": cfg["bundle_version"], "gjc": installed_gjc(),
          "platform": host_platform(), "ncpu": os.cpu_count(), "host": os.uname().nodename, "origin": origin})


def v_probe(origin: str, args: list[str]) -> None:
    cfg = load_config()
    model = None
    repo = None
    i = 0
    while i < len(args):
        if args[i] == "--model":
            model = need("model", args[i + 1]); i += 2
        elif args[i] == "--repo":
            repo = need("repo", args[i + 1]); i += 2
        else:
            raise HelperError("bad_argument", args[i], 64)
    with Flock(SLOTS_LOCK):
        slots = slots_load()
    # 읽기 전용 계산: 다음 reserve가 회수할 슬롯(lease 만료·종료 표식)은 쓰는 수에서 뺀다.
    t = now()
    live = [s for s in slots if not os.path.exists(ended_marker(s["job"], s["gen"]))
            and not (s["state"] in ("reserved", "staged") and s["lease_until"] < t)]
    snap = load_snapshot()
    res = {"ok": True, "snapshot": snap, "slots_used": len(live), "slots_max": cfg["max_slots"],
           "load_max": cfg["load_max"], "gjc": installed_gjc(), "trusted_gjc": sorted(trusted_gjc()),
           "platform": host_platform(),
           "credential": os.path.exists(KEY_FILE), "bundle_version": cfg["bundle_version"],
           "admission": admission(cfg)}
    if model:
        res["model_rejection"] = model_check(cfg, model)
    if repo:
        cache = os.path.join(REPOS, f"{repo}.git")
        held = []
        if os.path.isdir(cache):
            proc = worktool(["held", repo], None, timeout=60)
            if proc.returncode == 0:
                held = json.loads(proc.stdout.decode().strip().splitlines()[-1]).get("held", [])
        res["held"] = held
    emit(res)


def admission(cfg: dict) -> list[str]:
    snap = load_snapshot()
    reasons = []
    if snap["load_ratio"] >= cfg["load_max"]:
        reasons.append("remote_overloaded")
    if snap["psi_mem"] is not None and snap["psi_mem"] > cfg["psi_mem_max"]:
        reasons.append("remote_overloaded")
    if snap["disk_free_gb"] < cfg["disk_min_gb"]:
        reasons.append("disk_low")
    if cfg.get("contention_slice") and (snap.get("contention_psi") or 0) > cfg["contention_psi_max"]:
        reasons.append(f"contention:{cfg['contention_slice']}")
    return sorted(set(reasons))


def v_reserve(origin: str, args: list[str]) -> None:
    if len(args) != 6:
        raise HelperError("bad_argument", "reserve", 64)
    job, gen_s, est_s, session, ver, model = args
    need("job", job); need("gen", gen_s); need("num", est_s); need("session", session)
    need("version", ver); need("model", model)
    gen, est = int(gen_s), int(est_s)
    check_reg(origin)
    cfg = load_config()
    sdir = job_state_dir(job)
    ensure_root_dir(os.path.join(STATE, "jobs"))
    meta = read_root_json(os.path.join(sdir, "meta.json"))
    if meta is not None:
        if meta["origin"] != origin or meta["main_session"] != session or meta["gen"] != gen:
            raise HelperError("job_conflict", status=3)
        emit({"ok": True, "duplicate": True, "cap": cap_token(origin, session, job, gen),
              "gjc_installed": gjc_binary_ok(ver), "platform": host_platform(), "state": meta.get("state")})
        return
    rej = model_check(cfg, model)
    if rej:
        raise HelperError(rej, status=3)
    if ver not in trusted_gjc():
        raise HelperError("gjc_version_untrusted", ver, 3)
    if not os.path.exists(KEY_FILE):
        raise HelperError("credential_missing", status=3)
    with Flock(SLOTS_LOCK):
        slots = reclaim(slots_load())
        if len(slots) >= cfg["max_slots"]:
            slots_save(slots)
            raise HelperError("slots_full", status=3)
        reasons = admission(cfg)
        if reasons:
            slots_save(slots)
            raise HelperError(reasons[0], ",".join(reasons), 3)
        ensure_root_dir(sdir)
        write_root_json(os.path.join(sdir, "meta.json"), {
            "job": job, "gen": gen, "origin": origin, "main_session": session, "est_min": est, "model": model,
            "gjc_version": ver, "bundle_version": cfg["bundle_version"], "state": "reserved", "created": iso()})
        slots.append({"job": job, "gen": gen, "state": "reserved", "lease_until": now() + cfg["lease_s"],
                      "main_session": session, "origin": origin, "invocation": None, "boot_id": None})
        slots_save(slots)
    emit({"ok": True, "duplicate": False, "cap": cap_token(origin, session, job, gen),
          "gjc_installed": gjc_binary_ok(ver), "platform": host_platform(), "lease_s": cfg["lease_s"]})


def extend_lease(job: str, gen: int, state: str | None = None) -> None:
    cfg = load_config()
    with Flock(SLOTS_LOCK):
        slots = slots_load()
        found = False
        for s in slots:
            if s["job"] == job and s["gen"] == gen and s["state"] in ("reserved", "staged"):
                s["lease_until"] = now() + cfg["lease_s"]
                if state:
                    s["state"] = state
                found = True
        if not found:
            raise HelperError("slot_missing", status=3)
        slots_save(slots)


def ensure_work_dir(job: str) -> None:
    root_parent = WORK
    st = os.lstat(root_parent)
    if st.st_uid != 0 or os.path.islink(root_parent):
        raise HelperError("state_untrusted", WORK)
    path = os.path.join(WORK, need("job", job))
    if not os.path.lexists(path):
        os.mkdir(path, 0o700)
        u = run_user()
        os.chown(path, u.pw_uid, u.pw_gid)


