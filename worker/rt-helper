def internal_finalize(job: str, gen_s: str) -> int:
    """ExecStopPost(root). ended 표식 → 슬롯 반납 → 권한을 내린 마무리(최선 노력)."""
    need("job", job)
    gen = int(need("gen", gen_s))
    marker = ended_marker(job, gen)
    if not os.path.exists(marker):
        write_root_json(marker, {"at": iso(), "service_result": os.environ.get("SERVICE_RESULT"),
                                 "exit_code": os.environ.get("EXIT_CODE"), "exit_status": os.environ.get("EXIT_STATUS")})
    with Flock(SLOTS_LOCK):
        slots = [s for s in slots_load() if not (s["job"] == job and s["gen"] == gen)]
        slots_save(slots)
    meta = read_root_json(os.path.join(job_state_dir(job), "meta.json")) or {}
    meta_update(job, state="ended", ended=iso())
    try:
        worktool(["finish", job, "forced"], job, timeout=150, bundle_version=meta.get("bundle_version"))
    except (subprocess.TimeoutExpired, OSError):
        pass
    return 0


def internal_gc() -> int:
    jobs_root = os.path.join(STATE, "jobs")
    try:
        names = os.listdir(jobs_root)
    except FileNotFoundError:
        return 0
    for job in names:
        if not RX["job"].match(job):
            continue
        meta = read_root_json(os.path.join(jobs_root, job, "meta.json"))
        if not meta or os.path.exists(os.path.join(jobs_root, job, "cleaned")):
            continue
        ended = read_root_json(ended_marker(job, meta["gen"]))
        age_ref = None
        if ended:
            age_ref = ended.get("at")
        elif meta.get("state") == "failed":
            age_ref = meta.get("created")
        if not age_ref:
            continue
        t = time.mktime(time.strptime(age_ref, "%Y-%m-%dT%H:%M:%SZ")) - time.timezone
        if now() - t > 7 * 86400:
            try:
                do_cleanup(job, meta)
            except HelperError:
                pass
    return 0


VERBS = {
    "hello": v_hello, "probe": v_probe, "reserve": v_reserve, "upload-base": v_upload_base,
    "prepare": v_prepare, "install-gjc": v_install_gjc, "launch": v_launch, "status": v_status,
    "events": v_events, "send": v_send, "bundle": v_bundle, "logs": v_logs, "cancel": v_cancel,
    "cleanup": v_cleanup,
}


def main(argv: list[str]) -> int:
    os.umask(0o077)
    try:
        if len(argv) >= 2 and argv[1] == "--internal":
            if os.environ.get("SUDO_USER"):
                raise HelperError("internal_only", status=77)
            if argv[2] == "finalize" and len(argv) == 5:
                return internal_finalize(argv[3], argv[4])
            if argv[2] == "gc" and len(argv) == 3:
                return internal_gc()
            raise HelperError("bad_argument", "internal", 64)
        if len(argv) < 4 or argv[1] != "--origin":
            raise HelperError("bad_argument", "usage", 64)
        origin = need("origin", argv[2])
        verb = argv[3]
        fn = VERBS.get(verb)
        if fn is None:
            raise HelperError("unknown_verb", status=64)
        fn(origin, argv[4:])
        return 0
    except HelperError as exc:
        sys.stderr.write(json.dumps({"error": exc.code, "detail": exc.detail}, ensure_ascii=False) + "\n")
        return exc.status
    except subprocess.TimeoutExpired:
        sys.stderr.write(json.dumps({"error": "timeout"}) + "\n")
        return 3
    except (OSError, ValueError, KeyError, IndexError, json.JSONDecodeError) as exc:
        sys.stderr.write(json.dumps({"error": "helper_failed", "detail": type(exc).__name__}) + "\n")
        return 4


if __name__ == "__main__":
    sys.exit(main(sys.argv))
