def v_prepare(origin: str, args: list[str]) -> None:
    if len(args) != 2:
        raise HelperError("bad_argument", "prepare", 64)
    job, gen = need("job", args[0]), int(need("gen", args[1]))
    meta = check_cap(origin, job)
    if meta["gen"] != gen:
        raise HelperError("gen_mismatch", status=3)
    if os.path.exists(os.path.join(job_state_dir(job), f"sealed-g{gen}")):
        raise HelperError("sealed", status=3)
    raw = sys.stdin.buffer.read(256 * 1024 + 1)
    if len(raw) > 256 * 1024:
        raise HelperError("payload_too_large", status=3)
    manifest = json.loads(raw)
    if not isinstance(manifest, dict):
        raise HelperError("bad_manifest", status=3)
    need("repo", manifest.get("repo_id", ""))
    if not re.match(r"^([0-9a-f]{40}|[0-9a-f]{64})$", str(manifest.get("base_sha", ""))):
        raise HelperError("bad_manifest", "base_sha", 3)
    checks = manifest.get("checks") or []
    if not isinstance(checks, list) or len(checks) > 10:
        raise HelperError("bad_manifest", "checks", 3)
    for c in checks:
        if not (isinstance(c, dict) and re.match(r"^[a-z0-9_-]{1,32}$", str(c.get("id", ""))) and isinstance(c.get("cmd"), str)
                and len(c["cmd"]) <= 2000):
            raise HelperError("bad_manifest", "check", 3)
    if not isinstance(manifest.get("task_md"), str) or len(manifest["task_md"]) > 200_000:
        raise HelperError("bad_manifest", "task_md", 3)
    extend_lease(job, gen)
    ensure_work_dir(job)
    full = {"repo_id": manifest["repo_id"], "base_sha": manifest["base_sha"], "task_md": manifest["task_md"],
            "checks": checks, "verify": "off" if manifest.get("verify") == "off" else "runner",
            "job": job, "gen": gen, "model": meta["model"], "est_min": meta["est_min"], "gjc_version": meta["gjc_version"]}
    res = worktool_input(["prepare", job], job, json.dumps(full).encode(), meta["bundle_version"])
    extend_lease(job, gen, "staged")
    meta_update(job, state="staged", repo_id=manifest["repo_id"])
    emit(res)


def v_install_gjc(origin: str, args: list[str]) -> None:
    if len(args) != 2:
        raise HelperError("bad_argument", "install-gjc", 64)
    ver, sha = need("version", args[0]), need("sha256", args[1])
    check_reg(origin)
    want = trusted_gjc().get(ver)
    if want != sha:
        raise HelperError("gjc_version_untrusted", ver, 3)
    if gjc_binary_ok(ver):
        sys.stdin.buffer.read()
        emit({"ok": True, "already": True})
        return
    d = os.path.join(LIB, "gjc", ver)
    os.makedirs(d, mode=0o755, exist_ok=True)
    os.chmod(d, 0o755)  # umask 077 아래에서 만들어져도 실행 계정이 읽고 실행할 수 있게
    tmp = os.path.join(d, f".gjc.tmp{os.getpid()}")
    h = hashlib.sha256()
    total = 0
    fd = os.open(tmp, os.O_CREAT | os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW, 0o755)
    with os.fdopen(fd, "wb") as f:
        while True:
            chunk = sys.stdin.buffer.read(1 << 20)
            if not chunk:
                break
            total += len(chunk)
            if total > 600 << 20:
                os.unlink(tmp)
                raise HelperError("payload_too_large", status=3)
            h.update(chunk)
            f.write(chunk)
    if h.hexdigest() != sha:
        os.unlink(tmp)
        raise HelperError("gjc_hash_mismatch", status=3)
    os.chmod(tmp, 0o755)
    os.replace(tmp, os.path.join(d, "gjc"))
    emit({"ok": True, "already": False, "bytes": total})


def v_launch(origin: str, args: list[str]) -> None:
    if len(args) != 2:
        raise HelperError("bad_argument", "launch", 64)
    job, gen = need("job", args[0]), int(need("gen", args[1]))
    meta = check_cap(origin, job)
    if meta["gen"] != gen:
        raise HelperError("gen_mismatch", status=3)
    cfg = load_config()
    unit = unit_name(job, gen)
    with Flock(os.path.join(job_state_dir(job), "lock")):
        if os.path.exists(os.path.join(job_state_dir(job), f"sealed-g{gen}")):
            raise HelperError("sealed", status=3)
        with Flock(SLOTS_LOCK):
            slots = slots_load()
            slot = next((s for s in slots if s["job"] == job and s["gen"] == gen), None)
        if slot is None:
            raise HelperError("slot_missing", status=3)
        if slot["state"] == "launched":
            emit({"ok": True, "already": True, "unit": unit, "invocation": slot.get("invocation")})
            return
        if slot["state"] != "staged":
            raise HelperError("not_staged", slot["state"], 3)
        if not gjc_binary_ok(meta["gjc_version"]):
            raise HelperError("gjc_hash_mismatch", status=3)
        if not os.path.exists(KEY_FILE):
            raise HelperError("credential_missing", status=3)
        w = os.path.join(WORK, job)
        bundle = os.path.join(LIB, "bundle", meta["bundle_version"])
        # 슬롯별 빌드 캐시(계획 위험 5): 같은 저장소의 다른 활성 슬롯이 쓰지 않는 가장 작은 번호를 이 잡이 슬롯을
        # 반납할 때까지 쓴다. 동시에 도는 잡끼리 target/을 덮어쓰지 않고, 다음 잡은 앞 잡의 빌드를 이어 쓴다(웜).
        repo_id = meta.get("repo_id") or ""
        cache_slot = None
        target_dir = None
        if re.match(r"^[0-9a-f]{16,64}$", repo_id):
            with Flock(SLOTS_LOCK):
                slots = slots_load()
                used = {x.get("cache_slot") for x in slots
                        if x.get("repo_id") == repo_id and not (x["job"] == job and x["gen"] == gen)}
                cache_slot = next(k for k in range(len(slots) + 1) if k not in used)
                for x in slots:
                    if x["job"] == job and x["gen"] == gen:
                        x.update(repo_id=repo_id, cache_slot=cache_slot)
                slots_save(slots)
            target_dir = os.path.join(SHARED_CACHE, "target", repo_id, f"s{cache_slot}")
            ru = run_user()
            for d in (os.path.join(SHARED_CACHE, "target"), os.path.join(SHARED_CACHE, "target", repo_id), target_dir):
                if not os.path.isdir(d):
                    os.mkdir(d, 0o700)
                    os.chown(d, ru.pw_uid, ru.pw_gid)
        runtime = min(int(meta["est_min"]) * 2, 480) * 60
        env = {
            "HOME": f"{w}/home", "XDG_CACHE_HOME": f"{w}/cache", "TMPDIR": f"{w}/tmp",
            "GJC_CODING_AGENT_DIR": f"{w}/agent", "GJC_RT_JOB_DIR": w, "GJC_RT_JOB": f"{job}-g{gen}",
            "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": f"{bundle}/gitconfig",
            "CARGO_BUILD_JOBS": str(cfg["cargo_jobs"]), "CARGO_HOME": f"{SHARED_CACHE}/cargo",
            "PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8",
        }
        if target_dir:
            env["CARGO_TARGET_DIR"] = target_dir
        # bun 설치 캐시도 cargo 레지스트리처럼 잡 사이에 공유한다(잡 HOME은 잡마다 새로 만들어져 늘 콜드가 된다).
        bun_cache = os.path.join(SHARED_CACHE, "bun")
        if not os.path.isdir(bun_cache):
            ru = run_user()
            os.mkdir(bun_cache, 0o700)
            os.chown(bun_cache, ru.pw_uid, ru.pw_gid)
        env["BUN_INSTALL_CACHE_DIR"] = bun_cache
        cmd = ["systemd-run", f"--unit={unit}", f"--slice=user-{run_user().pw_uid}.slice", f"--uid={RUN_USER}", f"--gid={RUN_USER}",
               "--collect", "-p", "Type=exec", "-p", "KillMode=control-group", "-p", "TimeoutStopSec=180",
               "-p", f"RuntimeMaxSec={runtime}", "-p", f"MemoryMax={cfg['job_memory_max']}",
               "-p", f"TasksMax={cfg['job_tasks_max']}", "-p", "ProtectSystem=strict",
               "-p", f"ReadWritePaths={w} {SHARED_CACHE}", "-p", f"InaccessiblePaths={STATE} {PRIV}",
               "-p", "PrivateTmp=yes", "-p", "NoNewPrivileges=yes", "-p", "StandardOutput=null",
               "-p", "StandardError=null", "-p", f"LoadCredential=gjc-rt-key:{KEY_FILE}",
               "-p", f"WorkingDirectory={w}",
               "-p", f"ExecStopPost=+/usr/bin/python3 {LIB}/rt-helper --internal finalize {job} {gen}"]
        for k, v in env.items():
            cmd.append(f"--setenv={k}={v}")
        cmd += ["--", "/usr/bin/python3", f"{bundle}/rt-runner.py", job, str(gen)]
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
        info = unit_show(unit)
        if proc.returncode != 0 and info.get("LoadState") != "loaded":
            raise HelperError("launch_failed", proc.stderr.decode("utf-8", "replace")[-300:], 3)
        with Flock(SLOTS_LOCK):
            slots = slots_load()
            for s in slots:
                if s["job"] == job and s["gen"] == gen:
                    s.update(state="launched", invocation=info.get("InvocationID"), boot_id=boot_id())
            slots_save(slots)
        meta_update(job, state="launched", invocation=info.get("InvocationID"), launched=iso())
    emit({"ok": True, "already": proc.returncode != 0, "unit": unit, "invocation": info.get("InvocationID")})


