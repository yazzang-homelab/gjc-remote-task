{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true, "types": ["bun"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["extension/**/*.ts", "test/**/*.ts", "worker/bundle/agent-template/extensions/**/*.ts", "scripts/**/*.ts"]
}
